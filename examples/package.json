{
  "name": "@ghia/examples",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "blurred-window": "ghia dev blurred-window.tsx",
    "titlebar": "ghia dev titlebar.main.tsx",
    "counter": "ghia dev counter.tsx",
    "diff": "ghia dev diff.main.tsx",
    "test": "vitest run --exclude '**/*.perf.test.tsx' --exclude 'tanstack-virtual.test.tsx' && bun run test:base-ui && bun run test:kobalte && bun run test:base-ui-solid && bun run test:solid",
    "test:base-ui": "vitest run --config vitest.base-ui.config.ts",
    "test:kobalte": "vitest run --config vitest.kobalte.config.ts",
    "test:base-ui-solid": "vitest run --config vitest.base-ui-solid.config.ts && vitest run --config vitest.base-ui-solid-msviderok.config.ts",
    "test:solid": "vitest run --config vitest.solid.config.ts",
    "test:perf": "NODE_ENV=production vitest run --no-file-parallelism chat.perf.test.tsx timeline.perf.test.tsx rerender.perf.test.tsx",
    "test:perf:overflow": "NODE_ENV=production vitest run --no-file-parallelism overflow-clip.perf.test.tsx",
    "test:perf:menus": "NODE_ENV=production vitest run --no-file-parallelism command-menus.perf.test.tsx",
    "test:perf:cq": "NODE_ENV=production vitest run --no-file-parallelism container-queries.perf.test.tsx",
    "test:perf:svg": "NODE_ENV=production vitest run --no-file-parallelism svg-raster.perf.test.tsx",
    "test:perf:depth": "NODE_ENV=production vitest run --no-file-parallelism depth-col.perf.test.tsx",
    "test:perf:animating": "NODE_ENV=production vitest run --no-file-parallelism one-animating-node.perf.test.tsx",
    "test:perf:clipped": "NODE_ENV=production vitest run --no-file-parallelism clipped.perf.test.tsx",
    "test:perf:retain": "NODE_ENV=production vitest run --no-file-parallelism retain.perf.test.tsx",
    "test:perf:layout-idle": "NODE_ENV=production vitest run --no-file-parallelism layout-idle.perf.test.tsx",
    "test:perf:draws": "NODE_ENV=production vitest run --no-file-parallelism draws-vs-presents.perf.test.tsx",
    "test:perf:swap": "NODE_ENV=production vitest run --no-file-parallelism page-swap.perf.test.tsx",
    "native-text": "ghia dev native-text.tsx",
    "chat": "ghia dev chat.main.tsx",
    "chat-solid": "ghia dev solid/main.tsx",
    "chat-solid:build": "ghia build solid/main.tsx",
    "infinite-chat": "ghia dev infinite-chat.main.tsx",
    "timeline": "ghia dev timeline.main.tsx",
    "mail": "ghia dev mail.main.tsx",
    "tanstack-virtual": "ghia dev solid/tanstack-virtual/main.tsx",
    "tanstack-virtual-measured": "MEASURED=1 ghia dev solid/tanstack-virtual/main.tsx",
    "profile-mailbox": "ghia dev solid/mailbox-scroll-hover/profile.tsx",
    "profile-mailbox-keys": "ghia dev solid/mailbox-scroll-hover/profile-keys.tsx",
    "profile-row-cost": "ghia dev solid/row-cost/profile.tsx",
    "profile-stylesheet-cost": "ghia dev solid/stylesheet-cost/profile.tsx",
    "profile-mount-cost": "ghia dev solid/mount-cost/profile.tsx",
    "profile-layout-scale": "ghia dev solid/layout-scale/profile.tsx",
    "mailbox-live": "ghia dev solid/mailbox-scroll-hover/live.tsx",
    "profile-navigate": "ghia dev solid/mailbox-navigate/profile.tsx",
    "compile": "bun compile-chat.ts",
    "bench:serde": "bun bench-serialization.ts"
  },
  "dependencies": {
    "@ghia/native": "workspace:^",
    "@ghia/react": "workspace:^",
    "@ghia/solid": "workspace:^",
    "@kmamal/sdl": "^0.11.12",
    "diff": "^7.0.0",
    "react": "^19.2.4",
    "safe-mdx": "1.14.0",
    "shiki": "^3.0.0",
    "solid-js": "1.9.15",
    "string-dedent": "^3.0.2"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@kobalte/core": "^0.13.14",
    "@msviderok/base-ui-solid": "github:msviderok/base-ui-solid#e49117f0106493a3f3981ea048c7b274c9fe0c2e&path:/packages/solid",
    "@photon-ai/base-ui-solid": "github:photon-hq/base-ui-solid#c155ca9c5e45cf9cf522808ea82bdf4412f68395&path:/packages/solid",
    "@stylexjs/stylex": "^0.19.2",
    "@stylexjs/unplugin": "^0.19.2",
    "@tanstack/solid-virtual": "3.13.53",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.2.0",
    "cbor-x": "^1.6.6",
    "ghia": "workspace:^",
    "msgpackr": "^2.0.6",
    "tsx": "^4.19.0",
    "vite": "^8.3.5",
    "vitest": "^4.0.18"
  }
}
