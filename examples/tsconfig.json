{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@ghia/react",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // `ghia dev` runs these files straight from source and `ghia build` bundles
    // them. Nothing here is ever compiled by tsc, so an accidental `tsc -p .`
    // must not litter the folder with .js next to every .tsx.
    "noEmit": true
  },
  "include": ["./*.tsx"]
}
