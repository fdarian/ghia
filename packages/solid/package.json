{
  "name": "@ghia/solid",
  "version": "0.12.1",
  "description": "Solid renderer for GPUIX",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js",
      "default": "./dist/web.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./automation": {
      "types": "./dist/automation.d.ts",
      "import": "./dist/automation.js",
      "default": "./dist/automation.js"
    },
    "./select": {
      "types": "./dist/components/select.d.ts",
      "import": "./dist/components/select.js",
      "default": "./dist/components/select.js"
    },
    "./combobox": {
      "types": "./dist/components/combobox.d.ts",
      "import": "./dist/components/combobox.js",
      "default": "./dist/components/combobox.js"
    },
    "./button": {
      "types": "./dist/components/button.d.ts",
      "import": "./dist/components/button.js",
      "default": "./dist/components/button.js"
    },
    "./dialog": {
      "types": "./dist/components/dialog.d.ts",
      "import": "./dist/components/dialog.js",
      "default": "./dist/components/dialog.js"
    },
    "./tooltip": {
      "types": "./dist/components/tooltip.d.ts",
      "import": "./dist/components/tooltip.js",
      "default": "./dist/components/tooltip.js"
    },
    "./floating": {
      "types": "./dist/components/floating.d.ts",
      "import": "./dist/components/floating.js",
      "default": "./dist/components/floating.js"
    }
  },
  "files": ["dist", "LICENSE", "NOTICE"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fdarian/ghia.git",
    "directory": "packages/solid"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "bun run build && bun --bun vitest run",
    "prepublishOnly": "node -e \"if (!process.env.CI) { console.error('Never publish @ghia/solid locally. CI is the only release path.'); process.exit(1) }\""
  },
  "dependencies": {
    "@ghia/native": "workspace:^",
    "solid-refresh": "^0.6.3",
    "vite-plugin-solid": "^2.11.15"
  },
  "peerDependencies": {
    "ghia": "workspace:^",
    "solid-js": ">=1.9 <2",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "ghia": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dnd-kit/solid": "0.5.3",
    "ghia": "workspace:^",
    "@types/bun": "^1.4.0",
    "@types/node": "^25.3.3",
    "solid-js": "1.9.15",
    "typescript": "^5.3.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.18"
  }
}
