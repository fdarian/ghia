{
  "name": "@ghia/vite",
  "version": "0.11.1",
  "description": "Vite toolchain for Ghia apps",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ghia": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "files": ["dist", "client.d.ts", "LICENSE"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fdarian/ghia.git",
    "directory": "packages/vite"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "bun run build && bun test",
    "prepublishOnly": "node -e \"if (!process.env.CI) { console.error('Never publish @ghia/vite locally. CI is the only release path.'); process.exit(1) }\""
  },
  "peerDependencies": {
    "@ghia/native": "workspace:^",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@ghia/native": "workspace:^",
    "@ghia/solid": "workspace:^",
    "@types/bun": "^1.4.0",
    "@types/node": "^25.3.3",
    "solid-js": "1.9.15",
    "typescript": "^5.3.0",
    "vite": "^8.0.0"
  }
}
